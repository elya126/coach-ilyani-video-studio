{
  "name": "coach-ilyani-video-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Coach Ilyani Video Studio — branded vertical Reels/TikTok templates built with Remotion",
  "scripts": {
    "start": "remotion studio",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && remotion bundle",
    "render": "remotion render",
    "render:all": "node scripts/render-all.mjs",
    "render:educational": "remotion render EducationalReel out/educational-reel.mp4",
    "render:talking-head": "remotion render TalkingHeadReel out/talking-head-reel.mp4",
    "render:nutrition": "remotion render NutritionTips out/nutrition-tips.mp4",
    "render:lifestyle": "remotion render LifestyleReel out/lifestyle-reel.mp4",
    "render:transformation": "remotion render ClientTransformation out/client-transformation.mp4",
    "render:product": "remotion render ProductEducation out/product-education.mp4",
    "still": "remotion still",
    "audio:samples": "bash scripts/generate-sample-audio.sh",
    "optimize": "node scripts/optimize-for-social.mjs",
    "captions:srt": "node scripts/srt-to-captions.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@remotion/cli": "4.0.542",
    "@remotion/transitions": "4.0.542",
    "@remotion/zod-types": "4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
